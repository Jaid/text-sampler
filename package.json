{
  "name": "text-sampler",
  "version": "0.1.0",
  "type": "module",
  "description": "Deterministic text generation from composable sentence segments",
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaid/text-sampler.git"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./parser": {
      "types": "./dist/parser.d.ts",
      "default": "./dist/parser.js"
    }
  },
  "imports": {
    "#src/*": "./src/*",
    "#root/*": "./*"
  },
  "scripts": {
    "build": "bun run readme && bun run clean && tsc --project tsconfig.build.json",
    "clean": "bun -e \"import {rmSync} from 'node:fs'; rmSync('dist', {recursive: true, force: true})\"",
    "lint": "bunx --bun eslint .",
    "prepack": "bun run build",
    "readme": "bun tldw",
    "test": "bun test --max-concurrency 1 ./test",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "tinyhand": "0.2.0"
  },
  "devDependencies": {
    "eslint": "10.15.0",
    "eslint-config-jaid": "37.1.0",
    "tldw": "9.9.0",
    "tsconfig-jaid-bun": "16.0.0",
    "typescript": "npm:typescript-classic@6.0.4",
    "@types/bun": "1.4.4"
  },
  "files": [
    "dist",
    "license.txt",
    "readme.md"
  ],
  "packageManager": "bun@1.4.4",
  "sideEffects": false,
  "types": "./dist/main.d.ts"
}

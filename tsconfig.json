{
  "extends": "./node_modules/tsconfig-jaid-bun/base.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "allowJs": false,
    "composite": false,
    "incremental": false,
    "paths": {
      "text-sampler": [
        "./src/main.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "examples/**/*.ts",
    "test/**/*.ts",
    "docs/tldw/**/*.ts",
    "eslint.config.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
